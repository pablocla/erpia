import { type NextRequest, NextResponse } from "next/server"
import { verifyCronAuth } from "@/lib/scheduling/cron-auth"
import { runFacturacionRecurrenteAllTenants } from "@/lib/scheduling/jobs/facturacion-recurrente"

export const maxDuration = 120

/**
 * GET/POST /api/cron/facturacion-recurrente
 * Auth: CRON_SECRET (Bearer) — mismo patrón que dispatch.
 */
export async function POST(request: Request) {
  const authError = verifyCronAuth(request)
  if (authError) return authError

  try {
    const result = await runFacturacionRecurrenteAllTenants()
    return NextResponse.json({ ok: true, ...result })
  } catch (error) {
    console.error("[Cron facturacion-recurrente]", error)
    return NextResponse.json(
      { error: error instanceof Error ? error.message : "Error cron" },
      { status: 500 },
    )
  }
}

export async function GET(request: NextRequest) {
  return POST(request)
}
