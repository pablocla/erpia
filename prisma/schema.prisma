  estado     String   @default("Pendiente") // "Pendiente", "Procesando", "Completado", "Error"
  progreso   Int      @default(0)
  resultado  Json?
  error      String?  @db.Text
  archivoUrl String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

