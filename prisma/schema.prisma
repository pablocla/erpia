// â”€â”€â”€ TIPOS DE ENVASE (RETORNABLES) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Maestro de tipos de envases retornables para distribuidoras de bebidas.
// Ejemplos: "CajÃ³n 24 latas", "BotellÃ³n 20L", "SifÃ³n 1L"
// REQUIERE MIGRACIÃ“N: prisma migrate dev --name add-envases-retornables

model TipoEnvase {
  id            Int      @id @default(autoincrement())
  nombre        String
  descripcion   String?
