// â”€â”€â”€ MOVIMIENTOS DE ENVASES â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Registra cada entrega y retorno de envases retornables.
// Saldo por cliente = SUM(entregados) - SUM(retornados)

model MovimientoEnvase {
  id              Int      @id @default(autoincrement())
  /// "entrega" = salida del depÃ³sito hacia cliente
  /// "retorno" = devoluciÃ³n del cliente al depÃ³sito
  /// "ajuste"  = correcciÃ³n de inventario (puede ser + o -)
  tipo            String // "entrega" | "retorno" | "ajuste"
  cantidad        Int // positivo siempre; el tipo define la direcciÃ³n
  fechaMovimiento DateTime @default(now())
  observaciones   String?

  tipoEnvaseId Int
  tipoEnvase   TipoEnvase @relation(fields: [tipoEnvaseId], references: [id])

  /// Cliente al que se entregaron / devolviÃ³ los envases
  clienteId Int?
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  /// Factura o remito de origen (opcional â€” para trazabilidad)
  facturaId Int?

  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  createdAt DateTime @default(now())

  @@index([empresaId, tipo])
  @@index([clienteId])
  @@index([tipoEnvaseId])
  @@map("movimientos_envase")
}

