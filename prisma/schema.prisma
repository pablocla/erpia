// â”€â”€â”€ MAESTRO DE PUNTOS DE VENTA â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Cada empresa puede tener varios puntos de venta (sucursales / canales)
// habilitados ante AFIP. El nÃºmero (1-9999) es el que va en el comprobante.

model PuntoVentaConfig {
  id                     Int      @id @default(autoincrement())
  /// NÃºmero habilitado ante AFIP (1â€“9999)
  numero                 Int
  nombre                 String
  descripcion            String?
  /// "electronico" | "manual" | "web" | "factura_credito"
  tipo                   String   @default("electronico")
  activo                 Boolean  @default(true)
  /// Indica si es el PV por defecto al emitir comprobantes
  esDefault              Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  /// Permite cobrar facturas offline y sincronizar cuando vuelva internet
  permiteOffline         Boolean  @default(false)
  /// Habilita broadcast al Customer Display (2do Monitor)
  customerDisplayEnabled Boolean  @default(false)

  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  series Serie[]

  @@unique([empresaId, numero])
  @@map("puntos_venta_config")
}

// â”€â”€â”€ MAESTRO DE SERIES â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Una Serie vincula un Punto de Venta con un Tipo de Comprobante AFIP.
// Controla la numeraciÃ³n correlativa e identifica la letra del comprobante.
// El tipo de comprobante AFIP se almacena como tipoCbteAfip segÃºn la tabla
// oficial de WSFE (ver lib/afip/tipos-comprobante.ts).

model Serie {
  id                Int      @id @default(autoincrement())
  /// Identificador legible: "FA-001", "FB-001", "NCA-001"
  codigo            String   @unique
  descripcion       String?
  /// CÃ³digo numÃ©rico del tipo de comprobante AFIP (1=Fac A, 6=Fac B, 11=Fac C, 3=NC A, 8=NC B, 13=NC C, etc.)
  tipoCbteAfip      Int
  /// Letra del comprobante: "A", "B", "C", "E", "M"
  letraComprobante  String
  /// Nombre descriptivo: "Factura A", "Nota de CrÃ©dito B"
  nombreComprobante String
  /// Ãšltimo nÃºmero emitido (se incrementa automÃ¡ticamente al emitir)
  ultimoNumero      Int      @default(0)
  activo            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  puntoVentaId Int
  puntoVenta   PuntoVentaConfig @relation(fields: [puntoVentaId], references: [id])

  facturas Factura[]

  /// Un PV no puede tener dos series del mismo tipo de comprobante
  @@unique([puntoVentaId, tipoCbteAfip])
  @@map("series")
}

// â”€â”€â”€ MAESTRO DE MONEDAS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// CatÃ¡logo ISO 4217. ARS es siempre la moneda base del sistema.
// Las cotizaciones histÃ³ricas se guardan en Cotizacion.

model Moneda {
  id          Int      @id @default(autoincrement())
  /// CÃ³digo ISO 4217 (ARS, USD, EUR, BRL, UYU)
  codigo      String   @unique
  descripcion String
  simbolo     String
  /// Si true, los importes se usan tal cual. Si false, se deben convertir.
  esBase      Boolean  @default(false)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cotizaciones     Cotizacion[]
  cuentasBancarias CuentaBancaria[]
  listasPrecios    ListaPrecio[]

  @@map("monedas")
}

// â”€â”€â”€ HISTÃ“RICO DE COTIZACIONES â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Tipo de cambio por fecha y tipo (oficial, MEP, CCL, blue).
// Se consulta para convertir importes en moneda extranjera a ARS base.

model Cotizacion {
  id        Int      @id @default(autoincrement())
  fecha     DateTime @db.Date
  /// "oficial" | "mep" | "ccl" | "blue" | "tarjeta"
  tipo      String   @default("oficial")
  /// CuÃ¡ntos ARS vale 1 unidad de la moneda extranjera
  valorArs  Decimal  @db.Decimal(18, 6)
  fuente    String?
  createdAt DateTime @default(now())

  monedaId Int
  moneda   Moneda @relation(fields: [monedaId], references: [id])

  @@unique([monedaId, fecha, tipo])
  @@map("cotizaciones")
}

// â”€â”€â”€ MAESTRO DE BANCOS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// CatÃ¡logo de entidades financieras segÃºn BCRA.
// CÃ³digo BCRA es el identificador oficial (e.g. 7 = Banco NaciÃ³n).

model Banco {
  id         Int      @id @default(autoincrement())
  /// CÃ³digo BCRA oficial
  codigoBcra String?  @unique
  nombre     String
  /// CÃ³digo SWIFT para transferencias internacionales
  swift      String?
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cuentas CuentaBancaria[]

  @@map("bancos")
}

// â”€â”€â”€ MAESTRO DE CUENTAS BANCARIAS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Cuentas bancarias propias de la empresa, de clientes o proveedores.
// CBU: 22 dÃ­gitos. Alias: hasta 20 caracteres alfanumÃ©ricos.

model CuentaBancaria {
  id           Int      @id @default(autoincrement())
  cbu          String?  @unique
  alias        String?
  numeroCuenta String?
  /// "CC" = Cuenta Corriente | "CA" = Caja de Ahorros | "virtual" = CVU
  tipo         String   @default("CC")
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bancoId  Int
  banco    Banco  @relation(fields: [bancoId], references: [id])
  monedaId Int
  moneda   Moneda @relation(fields: [monedaId], references: [id])

  /// Solo uno de estos deberÃ­a ser no-nulo (empresa, cliente o proveedor)
  empresaId   Int?
  empresa     Empresa?   @relation(fields: [empresaId], references: [id])
  clienteId   Int?
  cliente     Cliente?   @relation(fields: [clienteId], references: [id])
  proveedorId Int?
  proveedor   Proveedor? @relation(fields: [proveedorId], references: [id])

  chequesEmitidos    Cheque[]             @relation("CuentaEmisor")
  chequesDepositados Cheque[]             @relation("CuentaDeposito")
  movimientos        MovimientoBancario[]

  @@map("cuentas_bancarias")
