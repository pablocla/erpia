  prefijo       String
  /// Ãšltimo nÃºmero emitido (correlativo)
  ultimoNumero  Int      @default(0)
  /// Cantidad de dÃ­gitos para el nÃºmero (8 â†’ 00000001)
  digitos       Int      @default(6)
  /// Sucursal/punto de venta (opcional, para esquemas PPPP-NNNNNNNN)
  sucursal      String?
