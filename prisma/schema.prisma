// â”€â”€â”€ PLAN DE CUENTAS EN DB (reemplaza plan-cuentas.ts hardcodeado) â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Cada empresa tiene su propio plan de cuentas adaptado al rubro.
// El seed genera un plan base segÃºn Empresa.rubro y la empresa lo personaliza.

model CuentaContable {
  id              Int              @id @default(autoincrement())
  /// CÃ³digo jerÃ¡rquico: "1.1", "1.1.1", "2.4.1", etc.
  codigo          String
  nombre          String
  /// "activo" | "pasivo" | "patrimonio" | "ingreso" | "egreso"
  tipo            String
  /// SubcategorÃ­a: "Disponibilidades", "Bienes de Cambio", "Deudas Fiscales", etc.
  categoria       String
  /// Naturaleza del saldo: "deudora" | "acreedora" â€” define si sube por debe o haber
  naturaleza      String           @default("deudora")
  /// Nivel jerÃ¡rquico (1=rubro, 2=subrubro, 3=cuenta, 4=subcuenta)
  nivel           Int              @default(3)
  /// Si true, permite imputar movimientos; si false, es cuenta de resumen
  imputable       Boolean          @default(true)
  /// Cuenta padre para jerarquÃ­a (null = cuenta raÃ­z)
  parentId        Int?
  parent          CuentaContable?  @relation("CuentaJerarquia", fields: [parentId], references: [id])
  hijos           CuentaContable[] @relation("CuentaJerarquia")
  /// CÃ³digo AFIP para mapeo fiscal (ej: libro IVA digital, SIRE)
  codigoAfip      String?
  /// Si true, esta cuenta se ajusta por inflaciÃ³n (RT 6 / NIC 29)
  ajustaInflacion Boolean          @default(false)
  /// Override moneda funcional (null = ARS). Para cuentas en moneda extranjera.
  monedaFuncional String?
  /// Rubro contable para agrupaciÃ³n en estados financieros (Balance / EERR)
  rubroContableId Int?
  rubroContable   RubroContable?   @relation(fields: [rubroContableId], references: [id])
  activo          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  empresaId Int
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  movimientos MovimientoContable[]

  @@unique([empresaId, codigo])
  @@index([empresaId, tipo])
  @@map("cuentas_contables")
}

// â”€â”€â”€ MAPEO DE ASIENTOS AUTOMÃTICOS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Define quÃ© cuenta contable usar para cada campo de cada tipo de transacciÃ³n.
