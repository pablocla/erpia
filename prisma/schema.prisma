// â”€â”€â”€ ESCALONES DE PRECIO (PRECIO POR VOLUMEN) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Permite definir tramos de precio por cantidad para un Ã­tem de lista de precios.
// Ejemplo: 1â€“5 unidades â†’ $100; 6â€“12 unidades â†’ $85; 13+ unidades â†’ $70
// REQUIERE MIGRACIÃ“N: prisma migrate dev --name add-escalones-precio

model EscalonPrecio {
