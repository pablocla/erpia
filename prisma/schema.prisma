  profesionId       Int?
  profesion         Profesion?       @relation(fields: [profesionId], references: [id])

  facturas                 Factura[]
  notasCredito             NotaCredito[]
  notasDebito              NotaDebito[]
  remitos                  Remito[]
  cuentasBancarias         CuentaBancaria[]
  cheques                  Cheque[]
  presupuestos             Presupuesto[]
  cuentasCobrar            CuentaCobrar[]
  recibos                  Recibo[]
  padronRegimenes          PadronRegimenCliente[]
  turnos                   Turno[]
  pacientes                Paciente[]
  membresias               Membresia[]
  pedidosVenta             PedidoVenta[]
  paradasRuta              ParadaRuta[]
  movimientosEnvase        MovimientoEnvase[]
  valesDinero              ValeDinero[]
  agroContratos            AgroContrato[]
  unidadesResidente        UnidadFuncional[]        @relation("ClienteResidente")
  propiedadesPropietario   Propiedad[]              @relation("PropiedadPropietario")
  contratosInquilino       ContratoAlquiler[]       @relation("ContratoInquilino")
  contratosPropietario     ContratoAlquiler[]       @relation("ContratoPropietario")
  nicheMovimientos         NicheMovimiento[]
  ordenServicios           OrdenServicio[]
  reservasHotel            ReservaHotel[]
  oficioTrabajos           OficioTrabajo[]
