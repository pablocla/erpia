  /// Fecha de alta como cliente
  fechaAlta                    DateTime  @default(now())
  /// Fecha de nacimiento / constituciÃ³n
  fechaNacimiento              DateTime?
  /// Observaciones libres
  observaciones                String?   @db.Text
  /// Si es agente de retenciÃ³n de IVA (RG 2854)
  esAgenteRetencionIVA         Boolean   @default(false)
  /// Si es agente de retenciÃ³n de Ganancias (RG 830)
  esAgenteRetencionGanancias   Boolean   @default(false)
  /// Si es agente de percepciÃ³n de IVA (RG 2408)
  esAgentePercepcionIVA        Boolean   @default(false)
  /// Si es agente de percepciÃ³n de IIBB
  esAgentePercepcionIIBB       Boolean   @default(false)
  /// NÃºmero de certificado de exclusiÃ³n de retenciÃ³n (si aplica)
  nroCertificadoExclusion      String?
  /// Vigencia del certificado de exclusiÃ³n
  vigenciaCertificadoExclusion DateTime?
  /// LÃ­mite de crÃ©dito en pesos (0 = sin lÃ­mite)
  limiteCredito                Decimal   @default(0) @db.Decimal(15, 2)
  /// Saldo de cuenta corriente (se actualiza vÃ­a triggers/service)
  saldoCuentaCorriente         Decimal   @default(0) @db.Decimal(15, 2)
  /// Descuento general que se aplica automÃ¡ticamente
  descuentoPct                 Decimal   @default(0) @db.Decimal(5, 2)
  /// CÃ³digo de cuenta contable asignada (ej: "1.3.1.001" Deudores por Ventas - Cliente X)
