  politicaDefault Json     @default("{}")
  activoCatalogo  Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  instancias EmpleadoDigital[]

  @@map("empleado_digital_templates")
}

model EmpleadoDigital {
  id               Int       @id @default(autoincrement())
  empresaId        Int
  templateId       Int
  nombre           String?
  /// trial | activo | pausado | cancelado | error_config
  estado           String    @default("pausado")
  sku              String
  cron             String?
  config           Json      @default("{}")
  lastRunAt        DateTime?
  lastSuccessAt    DateTime?
  runsTotal        Int       @default(0)
  accionesTotal    Int       @default(0)
  tokensMes        Int       @default(0)
  accionesMes      Int       @default(0)
  valorEstimadoArs Decimal   @default(0) @db.Decimal(18, 2)
  activatedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  empresa  Empresa                 @relation(fields: [empresaId], references: [id])
  template EmpleadoDigitalTemplate @relation(fields: [templateId], references: [id])
  runs     EmpleadoDigitalRun[]
  tareas   EmpleadoDigitalTarea[]
  usage    EmpleadoDigitalUsage[]

  @@unique([empresaId, sku])
  @@index([empresaId, estado])
  @@index([empresaId, templateId])
  @@map("empleados_digitales")
}

model EmpleadoDigitalRun {
  id                BigInt    @id @default(autoincrement())
  empresaId         Int
  empleadoDigitalId Int
  /// cron | event | manual | api
  triggeredBy       String
  eventKey          String?
  /// running | success | partial | error | skipped
  status            String    @default("running")
  /// rules | hybrid | llm | none
  pathUsado         String    @default("rules")
  resumen           String?   @db.Text
  error             String?   @db.Text
  detalles          Json?
  durationMs        Int       @default(0)
  tokensIn          Int       @default(0)
  tokensOut         Int       @default(0)
  costoEstimadoUsd  Decimal?  @db.Decimal(12, 6)
  accionesCount     Int       @default(0)
  idempotencyKey    String?   @unique
  createdAt         DateTime  @default(now())
  finishedAt        DateTime?

  empresa  Empresa                @relation(fields: [empresaId], references: [id])
  empleado EmpleadoDigital        @relation(fields: [empleadoDigitalId], references: [id], onDelete: Cascade)
  tareas   EmpleadoDigitalTarea[]
  usage    EmpleadoDigitalUsage[]

  @@index([empresaId, empleadoDigitalId, createdAt])
  @@index([empresaId, status, createdAt])
  @@map("empleado_digital_runs")
}

model EmpleadoDigitalTarea {
  id                BigInt    @id @default(autoincrement())
  empresaId         Int
  empleadoDigitalId Int
  runId             BigInt?
  /// recordatorio | wa_borrador | wa_enviado | seguimiento | estado
  tipo              String
  /// pendiente | aprobada | rechazada | enviada | cancelada | error
  estado            String    @default("pendiente")
  prioridad         Int       @default(5)
  clienteId         Int?
  montoArs          Decimal?  @db.Decimal(18, 2)
  diasVencido       Int?
  telefono          String?
  mensaje           String?   @db.Text
  /// template | llm | manual
  origenMensaje     String    @default("template")
  payload           Json?
  aprobadoPorUserId Int?
  aprobadoAt        DateTime?
  enviadoAt         DateTime?
  mensajeWaId       Int?
  error             String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  empresa  Empresa             @relation(fields: [empresaId], references: [id])
  empleado EmpleadoDigital     @relation(fields: [empleadoDigitalId], references: [id], onDelete: Cascade)
  run      EmpleadoDigitalRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([empresaId, empleadoDigitalId, estado])
  @@index([empresaId, clienteId, estado])
  @@index([empresaId, createdAt])
  @@map("empleado_digital_tareas")
}

model EmpleadoDigitalUsage {
  id                BigInt   @id @default(autoincrement())
  empresaId         Int
  empleadoDigitalId Int
  runId             BigInt?
  /// action | token | wa_draft | wa_send | llm_call | read_deudas
  kind              String
  quantity          Int      @default(1)
  tokensIn          Int      @default(0)
  tokensOut         Int      @default(0)
  tool              String?
  metadata          Json?
  createdAt         DateTime @default(now())
  periodMonth       String

  empresa  Empresa             @relation(fields: [empresaId], references: [id])
  empleado EmpleadoDigital     @relation(fields: [empleadoDigitalId], references: [id], onDelete: Cascade)
  run      EmpleadoDigitalRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([empresaId, periodMonth])
  @@index([empresaId, empleadoDigitalId, periodMonth])
  @@index([empresaId, kind, createdAt])
  @@map("empleado_digital_usage")
}

model VehiculoConcesionaria {
