// â”€â”€â”€ MAESTRO DE CHEQUES â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Cheques de terceros (recibidos de clientes) y propios (emitidos a proveedores).
// El "ciclo de vida": cartera â†’ depositado/endosado/rechazado, o emitido â†’ debitado/rechazado.

model Cheque {
  id                Int      @id @default(autoincrement())
  numero            String
  /// "propio" = cheque de la empresa | "tercero" = recibido de un cliente
  tipoCheque        String   @default("tercero")
  monto             Decimal  @db.Decimal(18, 2)
  fechaEmision      DateTime @db.Date
  fechaVencimiento  DateTime @db.Date
  /// Nombre del banco librador
  bancoNombre       String?
  /// CUIT del banco librador (para cheques de terceros)
  cuitBancoLibrador String?
  /// "cartera" | "depositado" | "endosado" | "rechazado" | "debitado" | "anulado"
  estado            String   @default("cartera")
  observaciones     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  /// Cuenta bancaria propia donde se deposita (para cheques de terceros)
  cuentaDepositoId Int?
  cuentaDeposito   CuentaBancaria? @relation("CuentaDeposito", fields: [cuentaDepositoId], references: [id])
  /// Cuenta bancaria propia contra la que se emite (para cheques propios)
  cuentaEmisorId   Int?
  cuentaEmisor     CuentaBancaria? @relation("CuentaEmisor", fields: [cuentaEmisorId], references: [id])

  clienteId   Int?
  cliente     Cliente?   @relation(fields: [clienteId], references: [id])
  proveedorId Int?
  proveedor   Proveedor? @relation(fields: [proveedorId], references: [id])

  /// VinculaciÃ³n con recibo de cobranza u orden de pago
  reciboId    Int?
  recibo      Recibo?    @relation(fields: [reciboId], references: [id])
  ordenPagoId Int?
  ordenPago   OrdenPago? @relation(fields: [ordenPagoId], references: [id])

  /// FIX A-001: endoso de cheques a proveedores
  endosadoAProveedorId Int?
  endosadoAProveedor   Proveedor? @relation("ChequeEndoso", fields: [endosadoAProveedorId], references: [id])

  /// Foto capturada del cheque
  fotoUrl String?

  /// FIX A-001: Ã­ndices para cartera de cheques
  @@index([estado, fechaVencimiento])
  @@index([reciboId])
  @@index([ordenPagoId])
  @@map("cheques")
}

// â”€â”€â”€ MOVIMIENTO BANCARIO â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Registro de dÃ©bitos y crÃ©ditos bancarios para conciliaciÃ³n.

model MovimientoBancario {
