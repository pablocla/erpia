// â”€â”€â”€ CUENTA A COBRAR â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Se genera al emitir factura a crÃ©dito. Se cancela con Recibos.

model CuentaCobrar {
  id               Int      @id @default(autoincrement())
  /// NÃºmero de cuota (1 para pago Ãºnico)
  numeroCuota      Int      @default(1)
  montoOriginal    Decimal  @db.Decimal(18, 2)
  montoPagado      Decimal  @default(0) @db.Decimal(18, 2)
  saldo            Decimal  @db.Decimal(18, 2)
  fechaEmision     DateTime @db.Date
  fechaVencimiento DateTime @db.Date
