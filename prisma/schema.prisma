// ─── WMS LIGHT — ubicaciones, tareas, olas, packing, HU, ASN ───────────────

/// Zona lógica del depósito: picking, bulk, staging, muelle, cuarentena
model ZonaAlmacen {
  id         Int      @id @default(autoincrement())
  empresaId  Int
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  depositoId Int
  deposito   Deposito @relation(fields: [depositoId], references: [id])
  codigo     String
  nombre     String
  /// "picking" | "bulk" | "staging" | "muelle" | "cuarentena" | "devoluciones" | "otro"
  tipo       String   @default("picking")
  ordenPath  Int      @default(0)
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ubicaciones UbicacionAlmacen[]

  @@unique([depositoId, codigo])
  @@index([empresaId, depositoId])
  @@map("zonas_almacen")
}

/// Bin / ubicación física (pasillo-rack-nivel-celda)
model UbicacionAlmacen {
  id         Int          @id @default(autoincrement())
  empresaId  Int
  empresa    Empresa      @relation(fields: [empresaId], references: [id])
  depositoId Int
  deposito   Deposito     @relation(fields: [depositoId], references: [id])
  zonaId     Int?
  zona       ZonaAlmacen? @relation(fields: [zonaId], references: [id])
  /// Código escaneable ej. "A-03-12"
  codigo     String
  pasillo    String?
  rack       String?
  nivel      String?
  celda      String?
  /// "bin" | "pick" | "bulk" | "stage" | "dock" | "quarantine"
  tipo       String       @default("bin")
  capacidad  Float?
  ordenPath  Int          @default(0)
  activo     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  stocks              StockUbicacion[]
  movimientosOrigen   MovimientoUbicacion[] @relation("MovUbicOrigen")
  movimientosDestino  MovimientoUbicacion[] @relation("MovUbicDestino")
  handlingUnits       HandlingUnit[]
  tareasOrigen        TareaWms[]            @relation("TareaFromBin")
  tareasDestino       TareaWms[]            @relation("TareaToBin")
  lineasPicking       LineaPicking[]
  lineasConteo        LineaConteoCiclico[]
  productosPreferidos Producto[]            @relation("ProductoUbicacionPreferida")

  @@unique([depositoId, codigo])
  @@index([empresaId, depositoId])
  @@index([empresaId, codigo])
  @@map("ubicaciones_almacen")
}

/// Stock por ubicación (y opcionalmente lote / HU)
model StockUbicacion {
  id          Int              @id @default(autoincrement())
  empresaId   Int
  empresa     Empresa          @relation(fields: [empresaId], references: [id])
  depositoId  Int
  deposito    Deposito         @relation(fields: [depositoId], references: [id])
  ubicacionId Int
  ubicacion   UbicacionAlmacen @relation(fields: [ubicacionId], references: [id])
  productoId  Int
  producto    Producto         @relation(fields: [productoId], references: [id])
  loteId      Int?
  lote        Lote?            @relation(fields: [loteId], references: [id])
  huId        Int?
  hu          HandlingUnit?    @relation(fields: [huId], references: [id])
  cantidad    Float            @default(0)
  reservado   Float            @default(0)
  updatedAt   DateTime         @updatedAt

  @@unique([ubicacionId, productoId, loteId, huId])
  @@index([empresaId, productoId])
  @@index([depositoId, productoId])
  @@map("stocks_ubicacion")
}

model MovimientoUbicacion {
  id              Int               @id @default(autoincrement())
  empresaId       Int
  empresa         Empresa           @relation(fields: [empresaId], references: [id])
  depositoId      Int
  deposito        Deposito          @relation(fields: [depositoId], references: [id])
  /// "putaway" | "pick" | "move" | "ajuste" | "recepcion" | "packing" | "replenish"
  tipo            String
  productoId      Int
  producto        Producto          @relation(fields: [productoId], references: [id])
  loteId          Int?
  lote            Lote?             @relation(fields: [loteId], references: [id])
  cantidad        Float
  fromUbicacionId Int?
  fromUbicacion   UbicacionAlmacen? @relation("MovUbicOrigen", fields: [fromUbicacionId], references: [id])
  toUbicacionId   Int?
  toUbicacion     UbicacionAlmacen? @relation("MovUbicDestino", fields: [toUbicacionId], references: [id])
  tareaWmsId      Int?
  tareaWms        TareaWms?         @relation(fields: [tareaWmsId], references: [id])
  motivo          String?
  createdBy       Int?
  createdAt       DateTime          @default(now())

  @@index([empresaId, createdAt])
  @@index([productoId, createdAt])
  @@map("movimientos_ubicacion")
}

/// Unidad de manejo: pallet / caja / LPN
model HandlingUnit {
  id          Int               @id @default(autoincrement())
  empresaId   Int
  empresa     Empresa           @relation(fields: [empresaId], references: [id])
  depositoId  Int
  deposito    Deposito          @relation(fields: [depositoId], references: [id])
  /// Código LPN/SSCC escaneable
  codigo      String
  /// "pallet" | "caja" | "tote" | "otro"
  tipo        String            @default("pallet")
  ubicacionId Int?
  ubicacion   UbicacionAlmacen? @relation(fields: [ubicacionId], references: [id])
  /// "abierta" | "cerrada" | "despachada" | "vacia"
  estado      String            @default("abierta")
  pesoKg      Float?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  stocks StockUbicacion[]
  tareas TareaWms[]

  @@unique([empresaId, codigo])
  @@index([depositoId, estado])
  @@map("handling_units")
}

/// Tarea de ejecución de piso (putaway, pick, move, count, replenish)
model TareaWms {
  id              Int               @id @default(autoincrement())
  empresaId       Int
  empresa         Empresa           @relation(fields: [empresaId], references: [id])
  depositoId      Int
  deposito        Deposito          @relation(fields: [depositoId], references: [id])
  numero          String
  /// "putaway" | "pick" | "move" | "count" | "replenish"
  tipo            String
  /// "pendiente" | "asignada" | "en_proceso" | "completada" | "cancelada" | "short"
  estado          String            @default("pendiente")
  prioridad       String            @default("normal")
  productoId      Int?
  producto        Producto?         @relation(fields: [productoId], references: [id])
  loteId          Int?
  lote            Lote?             @relation(fields: [loteId], references: [id])
  cantidadPedida  Float             @default(0)
  cantidadHecha   Float             @default(0)
  fromUbicacionId Int?
  fromUbicacion   UbicacionAlmacen? @relation("TareaFromBin", fields: [fromUbicacionId], references: [id])
  toUbicacionId   Int?
  toUbicacion     UbicacionAlmacen? @relation("TareaToBin", fields: [toUbicacionId], references: [id])
  huId            Int?
  hu              HandlingUnit?     @relation(fields: [huId], references: [id])
  listaPickingId  Int?
  pedidoVentaId   Int?
  olaPickingId    Int?
  olaPicking      OlaPicking?       @relation(fields: [olaPickingId], references: [id])
  asnId           Int?
  asn             AsnRecepcion?     @relation(fields: [asnId], references: [id])
  operarioId      Int?
  operarioNombre  String?
  ordenPath       Int               @default(0)
  notas           String?
  completedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  movimientos MovimientoUbicacion[]

  @@unique([empresaId, numero])
  @@index([empresaId, estado, tipo])
  @@index([depositoId, estado])
  @@map("tareas_wms")
}

/// Ola de picking (wave)
model OlaPicking {
  id          Int       @id @default(autoincrement())
  empresaId   Int
  empresa     Empresa   @relation(fields: [empresaId], references: [id])
  depositoId  Int
  deposito    Deposito  @relation(fields: [depositoId], references: [id])
  numero      String
  /// "borrador" | "liberada" | "en_proceso" | "completada" | "cancelada"
  estado      String    @default("borrador")
  /// Criterio de agrupación libre: carrier, ruta, cutoff, prioridad
  criterio    String?
  carrier     String?
  cutoffAt    DateTime?
  notas       String?
  liberadaAt  DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  listas ListaPicking[]
  tareas TareaWms[]

  @@unique([empresaId, numero])
  @@index([empresaId, estado])
  @@map("olas_picking")
}

model PackingList {
  id             Int       @id @default(autoincrement())
  empresaId      Int
  empresa        Empresa   @relation(fields: [empresaId], references: [id])
  depositoId     Int?
  deposito       Deposito? @relation(fields: [depositoId], references: [id])
  numero         String
  pedidoVentaId  Int?
  listaPickingId Int?
  /// "borrador" | "en_packing" | "cerrada" | "despachada"
  estado         String    @default("borrador")
  bultos         Int       @default(0)
  pesoKg         Float?
  dimensiones    String?
  etiquetaUrl    String?
  carrierId      String?
  tracking       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lineas        LineaPacking[]
  bultosDetalle PackingBulto[]

  @@unique([empresaId, numero])
  @@index([empresaId, estado])
  @@map("packing_lists")
}

model LineaPacking {
  id            Int         @id @default(autoincrement())
  packingListId Int
  packingList   PackingList @relation(fields: [packingListId], references: [id], onDelete: Cascade)
  productoId    Int?
  producto      Producto?   @relation(fields: [productoId], references: [id])
  descripcion   String
  cantidad      Float
  bultoNumero   Int         @default(1)

  @@map("lineas_packing")
}

model PackingBulto {
  id            Int         @id @default(autoincrement())
  packingListId Int
  packingList   PackingList @relation(fields: [packingListId], references: [id], onDelete: Cascade)
  numero        Int
  pesoKg        Float?
  largoCm       Float?
  anchoCm       Float?
  altoCm        Float?
  etiquetaUrl   String?
  tracking      String?

  @@unique([packingListId, numero])
  @@map("packing_bultos")
}

/// Advanced Shipping Notice — preaviso de mercadería en camino
model AsnRecepcion {
  id             Int       @id @default(autoincrement())
  empresaId      Int
  empresa        Empresa   @relation(fields: [empresaId], references: [id])
  depositoId     Int
  deposito       Deposito  @relation(fields: [depositoId], references: [id])
  numero         String
  ordenCompraId  Int?
  proveedorId    Int?
  /// "esperada" | "en_recepcion" | "cerrada" | "cancelada"
  estado         String    @default("esperada")
  eta            DateTime?
  /// Si true, recepción ciega (no muestra cantidades esperadas en UI RF)
  recepcionCiega Boolean   @default(false)
  notas          String?
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lineas LineaAsn[]
  tareas TareaWms[]

  @@unique([empresaId, numero])
  @@index([empresaId, estado])
  @@map("asn_recepciones")
}

model LineaAsn {
  id               Int          @id @default(autoincrement())
  asnId            Int
  asn              AsnRecepcion @relation(fields: [asnId], references: [id], onDelete: Cascade)
  productoId       Int?
  producto         Producto?    @relation(fields: [productoId], references: [id])
  loteId           Int?
  lote             Lote?        @relation(fields: [loteId], references: [id])
  descripcion      String
  cantidadEsperada Float
  cantidadRecibida Float        @default(0)
  /// "pendiente" | "parcial" | "completo" | "excedente" | "faltante"
  estado           String       @default("pendiente")

  @@map("lineas_asn")
}

/// Conteo cíclico ABC por ubicación
model ConteoCiclico {
  id         Int       @id @default(autoincrement())
  empresaId  Int
  empresa    Empresa   @relation(fields: [empresaId], references: [id])
  depositoId Int
  deposito   Deposito  @relation(fields: [depositoId], references: [id])
  numero     String
  /// Filtro ABC: "A" | "B" | "C" | "todas"
  claseAbc   String    @default("todas")
  /// "borrador" | "en_conteo" | "cerrado"
  estado     String    @default("borrador")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  closedAt   DateTime?

  lineas LineaConteoCiclico[]

  @@unique([empresaId, numero])
  @@map("conteos_ciclicos")
}

model LineaConteoCiclico {
  id            Int              @id @default(autoincrement())
  conteoId      Int
  conteo        ConteoCiclico    @relation(fields: [conteoId], references: [id], onDelete: Cascade)
  ubicacionId   Int
  ubicacion     UbicacionAlmacen @relation(fields: [ubicacionId], references: [id])
  productoId    Int
  producto      Producto         @relation(fields: [productoId], references: [id])
  stockSistema  Float            @default(0)
  stockContado  Float?
  diferencia    Float?
  observaciones String?

  @@map("lineas_conteo_ciclico")
}

// ==========================================
// MÓDULO CLAVER OFICIOS & OBRAS (AISLADO)
// ==========================================

enum EstadoTrabajoOficio {
  PRESUPUESTADO
  CONFIRMADO
  EN_CURSO
  FINALIZADO
  CANCELADO
  EN_GARANTIA
}

enum TipoOficio {
  PLOMERIA_GAS
  ELECTRICIDAD
  PINTURA
  ALBANILERIA_OBRA
  REFRIGERACION_CLIMA
  TECHOS_ZINGUERIA
  CERRAJERIA
  HERRERIA
  CARPINTERIA
  LIMPIEZA_FINAL_OBRA
  JARDINERIA_ESPACIOS
  INSTALACIONES_REDES_CAMARAS
  GENERAL
}

model OficioTrabajo {
  id           String              @id @default(uuid())
  empresaId    Int
  empresa      Empresa             @relation(fields: [empresaId], references: [id])
  clienteId    Int?
  cliente      Cliente?            @relation(fields: [clienteId], references: [id])
  tokenPublico String              @unique @default(cuid())
  numero       Int                 @default(autoincrement())
  tipoOficio   TipoOficio          @default(GENERAL)
  titulo       String
  descripcion  String?             @db.Text
  direccion    String?
  ubicacionGps String?
  fechaPactada DateTime?
  estado       EstadoTrabajoOficio @default(PRESUPUESTADO)

  // Cotización en 3 Niveles (JSON estructurado)
  opcionesPresupuesto Json?
  opcionElegida       String?
  montoAcordado       Decimal? @db.Decimal(12, 2)
  porcentajeSena      Int      @default(30)
  validezDias         Int      @default(7)

  // Cobranza Mercado Pago & Finanzas
  mpPreferenceIdSena  String?
  mpPaymentIdSena     String?
  senaPagada          Boolean @default(false)
  mpPreferenceIdSaldo String?
  mpPaymentIdSaldo    String?
  saldoPagado         Boolean @default(false)
  medioPagoFinal      String?

  // Evidencias fotográficas
  fotosAntes      String[] @default([])
  fotosDespues    String[] @default([])
  firmaClienteUrl String?  @db.Text

  // Post-Venta & Encuesta
  calificacionEstrellas Int?
  resenaComentario      String?
  garantiaHasta         DateTime?

  // Mantenimiento preventivo recurrente
  proximoServiceMeses  Int?
  fechaProximoService  DateTime?
  alertaServiceEnviada Boolean   @default(false)

  // Relaciones del módulo
  asignaciones     OficioAsignacion[]
  contrato         OficioContratoObra?
  checklists       OficioChecklistEjecucion[]
  gastosMateriales OficioGastoMaterial[]

  ventaId           Int?
  cuentaCorrienteId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId, estado])
  @@index([empresaId, fechaProximoService])
  @@index([tokenPublico])
  @@map("oficio_trabajos")
}

model OficioGastoMaterial {
  id            String  @id @default(uuid())
  trabajoId     String
  proveedor     String?
  monto         Decimal @db.Decimal(10, 2)
  fotoTicketUrl String?
  ocrDetalle    String? @db.Text
  reembolsable  Boolean @default(false)

  trabajo OficioTrabajo @relation(fields: [trabajoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([trabajoId])
  @@map("oficio_gastos_materiales")
}

model OficioOperario {
  id          String   @id @default(uuid())
  empresaId   Int
  empresa     Empresa  @relation(fields: [empresaId], references: [id])
  nombre      String
  telefono    String
  rol         String
  valorJornal Decimal? @db.Decimal(10, 2)
  activo      Boolean  @default(true)

  asignaciones OficioAsignacion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId, activo])
  @@map("oficio_operarios")
}

model OficioAsignacion {
  id          String    @id @default(uuid())
  trabajoId   String
  operarioId  String
  fecha       DateTime  @default(now())
  horaLlegada DateTime?
  horaSalida  DateTime?
  notas       String?

  trabajo  OficioTrabajo  @relation(fields: [trabajoId], references: [id], onDelete: Cascade)
  operario OficioOperario @relation(fields: [operarioId], references: [id], onDelete: Cascade)

  @@index([trabajoId])
  @@index([operarioId])
  @@map("oficio_asignaciones")
}

model OficioBoletinTecnico {
  id            String   @id @default(uuid())
  empresaId     Int
  empresa       Empresa  @relation(fields: [empresaId], references: [id])
  trabajoId     String?
  titulo        String
  contenido     String   @db.Text
  archivosUrls  String[]
  destinatarios String

  createdAt DateTime @default(now())

  @@index([empresaId])
  @@map("oficio_boletines_tecnicos")
}

model OficioPlantillaProceso {
  id         String     @id @default(uuid())
  empresaId  Int?
  tipoOficio TipoOficio
  nombre     String
  pasosJson  Json

  createdAt DateTime @default(now())

  @@index([empresaId, tipoOficio])
  @@map("oficio_plantillas_proceso")
}

model OficioChecklistEjecucion {
  id         String  @id @default(uuid())
  trabajoId  String
  nombre     String
  pasosJson  Json
  completado Boolean @default(false)

  trabajo OficioTrabajo @relation(fields: [trabajoId], references: [id], onDelete: Cascade)

  @@index([trabajoId])
  @@map("oficio_checklists_ejecucion")
}

model OficioContratoObra {
  id            String  @id @default(uuid())
  empresaId     Int
  trabajoId     String  @unique
  clausulasJson Json
  montoTotal    Decimal @db.Decimal(12, 2)
  formaPago     String
  plazoDias     Int?

  firmadoPorCliente Boolean   @default(false)
  fechaFirma        DateTime?
  firmaDigitalUrl   String?   @db.Text
  ipFirma           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trabajo OficioTrabajo @relation(fields: [trabajoId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@map("oficio_contratos_obra")
}

model AfiliadoReferido {
  id               String  @id @default(uuid())
  codigoAfiliado   String  @unique
  empresaId        Int     @unique
  empresa          Empresa @relation(fields: [empresaId], references: [id])
  aliasMercadoPago String?

  padreAfiliadoId String?

  comisionNivel1Pct Decimal @default(25.0) @db.Decimal(5, 2)
  comisionNivel2Pct Decimal @default(10.0) @db.Decimal(5, 2)

  saldoAcumulado Decimal @default(0.0) @db.Decimal(12, 2)
  totalCobrado   Decimal @default(0.0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([codigoAfiliado])
  @@map("afiliados_referidos")
}

model OficioMaquinaria {
  id            String   @id @default(uuid())
  empresaId     Int
  empresa       Empresa  @relation(fields: [empresaId], references: [id])
  codigo        String
  nombre        String
  categoria     String   @default("Herramientas")
  numeroSerie   String?
  estado        String   @default("DISPONIBLE") // DISPONIBLE | ALQUILADO | EN_MANTENIMIENTO | DE_BAJA
  tarifaDiaria  Decimal  @db.Decimal(10, 2)
  tarifaSemanal Decimal? @db.Decimal(10, 2)
  tarifaMensual Decimal? @db.Decimal(10, 2)
  montoGarantia Decimal? @db.Decimal(10, 2)
  horasUso      Int      @default(0)
  fotosUrls     String[]
  activo        Boolean  @default(true)

  alquileres OficioAlquilerContrato[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, codigo])
  @@index([empresaId, estado])
  @@map("oficio_maquinarias")
}

model OficioAlquilerContrato {
  id           String           @id @default(uuid())
  empresaId    Int
  empresa      Empresa          @relation(fields: [empresaId], references: [id])
  clienteId    Int
  cliente      Cliente          @relation(fields: [clienteId], references: [id])
  maquinariaId String
  maquinaria   OficioMaquinaria @relation(fields: [maquinariaId], references: [id])
  trabajoId    String?

  fechaInicio            DateTime  @default(now())
  fechaPactadaDevolucion DateTime
  fechaDevolucionReal    DateTime?

  estado           String  @default("ACTIVO") // ACTIVO | DEVUELTO | VENCIDO_EN_MORA | DANADO
  montoPactado     Decimal @db.Decimal(12, 2)
  depositoGarantia Decimal @default(0.0) @db.Decimal(12, 2)
  depositoDevuelto Boolean @default(false)
  cargosExtras     Decimal @default(0.0) @db.Decimal(12, 2)

  fotosEntrega    String[]
  fotosDevolucion String[]
  firmaClienteUrl String?  @db.Text
  remitoNumero    String?
  observaciones   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId, estado])
  @@index([clienteId])
  @@map("oficio_alquiler_contratos")
}

model AgentApiKey {
  id          String    @id @default(cuid())
  empresaId   Int
  agentId     String
  floorId     String
  keyHash     String    @unique
  permisos    String[]
  activa      Boolean   @default(true)
  creadaEn    DateTime  @default(now())
  ultimoUso   DateTime?
  empresa     Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  
  @@index([empresaId, agentId])
}

// ─── Claver Analytics — PageView & Funnel Tracking ─────────────────────

model PageView {
  id         Int      @id @default(autoincrement())
  sessionId  String   @db.VarChar(64)
  empresaId  Int?
  usuarioId  Int?
  path       String   @db.VarChar(500)
  referrer   String?  @db.VarChar(500)
  userAgent  String?  @db.VarChar(500)
  duracionMs Int?
  evento     String   @default("pageview") @db.VarChar(100)
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([sessionId])
  @@index([empresaId])
  @@index([path])
  @@index([createdAt])
  @@index([evento])
  @@map("page_views")
}

model FunnelStep {
  id         Int      @id @default(autoincrement())
  sessionId  String   @db.VarChar(64)
  empresaId  Int?
  usuarioId  Int?
  funnelId   String   @db.VarChar(50)
  stepOrder  Int
  stepName   String   @db.VarChar(100)
  completed  Boolean  @default(false)
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([funnelId, stepOrder])
  @@index([sessionId])
  @@index([createdAt])
  @@map("funnel_steps")
}
