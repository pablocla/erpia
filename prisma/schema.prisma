generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Empresa {
  id                     Int       @id @default(autoincrement())
  nombre                 String
  razonSocial            String
  cuit                   String    @unique
  direccion              String?
  telefono               String?
  email                  String?
  certificadoCRT         String? // Base64 encoded
  certificadoKEY         String? // Base64 encoded
  puntoVenta             Int       @default(1)
  entorno                String    @default("homologacion") // "homologacion" o "produccion"
  /// Alias para compatibilidad con cÃ³digo que usa entornoAfip
  entornoAfip            String    @default("homologacion")
  // â”€â”€ CAEA (RG 5782/2025 â€” contingencia offline) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  /// CAEA vigente para emitir comprobantes offline
  caeaVigente            String?
  /// PerÃ­odo del CAEA (YYYYMM)
  caeaPeriodo            String?
  /// Quincena: 1 = dÃ­as 1-15, 2 = dÃ­as 16 al Ãºltimo
  caeaQuincena           Int?
  /// Fecha inicio de vigencia del CAEA
  caeaVigDesde           DateTime?
  /// Fecha fin de vigencia del CAEA
  caeaVigHasta           DateTime?
  /// Tope para informar comprobantes emitidos con CAEA
  caeaTopeInformar       DateTime?
  /// Rubro de la empresa: define plan de cuentas base y mÃ³dulos sugeridos
  /// "comercio" | "industria" | "servicios" | "gastronomia" | "salud" | "hoteleria" | "agro" | "construccion" | "transporte" | "educacion" | "otro"
  rubro                  String    @default("comercio")
  /// FK al maestro Rubro (coexiste con rubro string para migraciÃ³n gradual)
  rubroId                Int?
  rubroRef               Rubro?    @relation("EmpresaRubro", fields: [rubroId], references: [id])
  /// "AR" | "CL" | "MX" â€” paÃ­s fiscal principal
  paisFiscal             String    @default("AR")
  /// CondiciÃ³n IVA de la empresa: "Responsable Inscripto" | "Monotributista" | "Exento"
  condicionIva           String    @default("Responsable Inscripto")
  /// Apariencia global del ERP (definida por dueÃ±o/admin, aplica a todos los usuarios)
  temaConfig             Json?
  /// Pack UX: pos | fiado | cobranza | niche | servicios | completo — default pos (no ERP ruidoso)
  modoLite               String    @default("pos")
  /// Libreta Fiado â€” requiere lÃ­mite de crÃ©dito por cliente
  fiadoRequiereLimite    Boolean   @default(true)
  emailDuenoAlmacen      String?
  fiadoNotificarWhatsApp Boolean   @default(true)
  mpSubscriptionId       String? // Added for Claver Cloud billing (F2-1)
  mpSubscriptionStatus   String? // "authorized", "paused", "cancelled", etc.
  planHosting            String    @default("Starter")
  trialExpiresAt         DateTime?
  /// Bandera para indicar si la empresa es un template pre-calentado
  isPrewarmedDemo        Boolean   @default(false)
  /// Industria asociada al pre-calentamiento (ej. "almacen")
  prewarmedIndustryId    String?
  activo                 Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  liquidaciones               LiquidacionImpuesto[]
  facturas                    Factura[]
