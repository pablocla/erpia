// â”€â”€â”€ MAESTRO DE INCOTERMS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// TÃ©rminos internacionales de comercio (ICC 2020) para operaciones de exportaciÃ³n/importaciÃ³n.

model Incoterm {
  id          Int      @id @default(autoincrement())
