}

// â”€â”€â”€ PARÃMETROS FISCALES CENTRALIZADOS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Constantes del sistema que hoy estÃ¡n hardcodeadas en servicios.
// Almacena umbrales, tolerancias, mÃ­nimos no imponibles y cualquier valor
// que pueda cambiar por normativa o por decisiÃ³n empresarial.

model ParametroFiscal {
  id            Int       @id @default(autoincrement())
  /// Clave Ãºnica del parÃ¡metro: "umbral_rg5824", "tolerancia_3way_match",
  ///   "minimo_sicore_305", "minimo_sicore_767", "iibb_pba_comercio", etc.
  clave         String
  /// Valor numÃ©rico del parÃ¡metro
  valor         Decimal   @db.Decimal(18, 4)
  /// DescripciÃ³n legible para UI
  descripcion   String?
