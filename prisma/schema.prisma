// â”€â”€â”€ LOG DE ACTIVIDAD (AUDITORÃA) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Registro de acciones de usuario para trazabilidad corporativa.

model LogActividad {
  id        Int      @id @default(autoincrement())
