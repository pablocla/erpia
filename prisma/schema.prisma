  canalVentaId Int
  canalVenta   CanalVenta @relation(fields: [canalVentaId], references: [id])

  /// Cuántas unidades "reservar" o descontar del stock real que se reporta al canal
  bufferReserva Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

