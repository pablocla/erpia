// â”€â”€â”€ RECIBO DE COBRANZA â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Documento que registra el pago del cliente. Cancela una o mÃ¡s CC.

model Recibo {
  id                 Int      @id @default(autoincrement())
  numero             String   @unique
  fecha              DateTime @db.Date
  montoTotal         Decimal  @db.Decimal(18, 2)
  /// "efectivo" | "transferencia" | "cheque" | "tarjeta"
  medioPago          String   @default("efectivo")
  /// Retenciones sufridas por el cobrador (IVA, Ganancias, IIBB)
  retencionIVA       Decimal  @default(0) @db.Decimal(18, 2)
  retencionGanancias Decimal  @default(0) @db.Decimal(18, 2)
  retencionIIBB      Decimal  @default(0) @db.Decimal(18, 2)
  totalRetenciones   Decimal  @default(0) @db.Decimal(18, 2)
  /// Neto efectivamente cobrado = montoTotal - totalRetenciones
  netoRecibido       Decimal  @default(0) @db.Decimal(18, 2)
  observaciones      String?
  anulada            Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  clienteId  Int
  cliente    Cliente   @relation(fields: [clienteId], references: [id])
  /// Cobrador que realizÃ³ la gestiÃ³n
  cobradorId Int?
  cobrador   Cobrador? @relation(fields: [cobradorId], references: [id])

  items              ItemRecibo[]
  /// Detalle de retenciones sufridas (con rÃ©gimen, certificado, base)
  retencionesDetalle RetencionRecibo[]
  cheques            Cheque[]
  mediosPago         ReciboMedioPago[]

  @@map("recibos")
}

