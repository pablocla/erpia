  /// DÃ­as de gracia extra sobre condiciÃ³n de pago para este cliente
  diasGraciaExtra              Int       @default(0)
  /// "pesos" | "dolares" | "euros"
  monedaHabitual               String    @default("pesos")
  /// Si es catalogado como Gran Empresa ante AFIP (sujeto a FCE MiPyME)
  esGranEmpresa                Boolean   @default(false)
  /// Si es un cliente del exterior (sujeto a Factura de ExportaciÃ³n)
  esExportacion                Boolean   @default(false)
  /// Si el cliente estÃ¡ activo para operar
  activo                       Boolean   @default(true)
  /// Cuenta de MercadoPago asociada para Split de pagos B2B / links
  mpAccountId                  String?
  /// Puntos de Lealtad (FidelizaciÃ³n)
