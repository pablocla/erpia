// â”€â”€â”€ IIBB â€” LiquidaciÃ³n mensual por jurisdicciÃ³n â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model PeriodoIIBB {
  id             Int      @id @default(autoincrement())
  mes            Int // 1â€“12
  anio           Int
  /// "PBA" | "CABA" | "SF" | "CBA" | "MZA"
  jurisdiccion   String
  /// "ARBA" | "ARCIBA" | "DGR_SF" | "DGR_CBA"
  organismo      String
  baseImponible  Float    @default(0)
  alicuota       Float
  montoDevengado Float    @default(0)
  /// Percepciones recibidas en el perÃ­odo (descuento sobre el saldo a pagar)
  montoPercibido Float    @default(0)
  saldo          Float    @default(0)
  /// "abierto" | "cerrado" | "presentado"
  estado         String   @default("abierto")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// Multi-tenant: empresa a la que pertenece el perÃ­odo
  empresaId Int?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  @@unique([mes, anio, jurisdiccion])
  @@map("periodos_iibb")
