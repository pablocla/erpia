// â”€â”€â”€ MAESTRO DE CONDICIONES DE PAGO â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Define la polÃ­tica de vencimiento: "Contado", "Net 15", "30/60/90", etc.
// diasVencimiento puede ser un array JSON: [30, 60, 90] para cuotas.

model CondicionPago {
  id              Int      @id @default(autoincrement())
  nombre          String   @unique
  descripcion     String?
  /// NÃºmero de cuotas (1 = contado o pago Ãºnico)
  cuotas          Int      @default(1)
  /// Para cuota Ãºnica: dÃ­as desde la factura. Para mÃºltiples: primer vencimiento.
  diasVencimiento Int      @default(0)
  /// JSON array de dÃ­as adicionales para cuotas 2, 3, ... ej: [30, 60]
  diasAdicionales Json?
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())
